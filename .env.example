# NINA Advanced API (mini PC)
NINA_HOST=192.168.1.211
NINA_PORT=1888

# LLM providers used by the harness. Add a block here for each new provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_SOL_MODEL=gpt-6-sol   # run with --provider openai-sol; same OPENAI_API_KEY, reasoning off

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-v4-pro   # run with --provider deepseek-pro; same DEEPSEEK_API_KEY, thinking off

ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-5-5   # run with --provider anthropic-haiku; native Messages API, thinking off
ANTHROPIC_SONNET_MODEL=claude-sonnet-5-5   # --provider anthropic-sonnet; thinking off (between_tools)
ANTHROPIC_OPUS_MODEL=claude-opus-5-5   # --provider anthropic-opus; thinking cannot be turned off, so effort is low

# Local model through Ollama (no key). Start the server with a context window big enough for the
# tool list: OLLAMA_CONTEXT_LENGTH=32768 ollama serve
OLLAMA_MODEL=qwen3:8b   # why this one: docs/local-model.md
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: let the harness restart Sky Simulator on the mini PC over SSH when a reset keeps failing.
# Needs the one-time setup in docs/minipc-remote.md. Leave MINIPC_SSH_USER unset to turn it off.
# MINIPC_SSH_USER=sergio
# MINIPC_SSH_KEY=~/.ssh/nina_minipc

# Which NINA devices to use. Set these to the ASCOM entries of the Sky Simulator devices: NINA's own
# Alpaca client drops the devices after about 4 minutes, the ASCOM route did not in 10 minutes of work
# (docs/simulator-notes.md, #34). Leave unset to use whatever NINA has selected.
# NINA_CAMERA_ID=ASCOM.AlpacaDynamic1.Camera
# NINA_MOUNT_ID=ASCOM.AlpacaDynamic1.Telescope
# NINA_FOCUSER_ID=ASCOM.AlpacaDynamic1.Focuser
# NINA_FILTERWHEEL_ID=ASCOM.AlpacaDynamic1.FilterWheel
# Set to also reset and watch the guider (PHD2 must be running with its server on); leave unset for tasks that do not guide.
# NINA_GUIDER_ID=PHD2_Single
