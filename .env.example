# NINA Advanced API (mini PC)
NINA_HOST=192.168.1.211
NINA_PORT=1888

# LLM providers used by the harness. Add a block here for each new provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Local model through Ollama (no key). Start the server with a context window big enough for the
# tool list: OLLAMA_CONTEXT_LENGTH=32768 ollama serve
OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: let the harness restart Sky Simulator on the mini PC over SSH when a reset keeps failing.
# Needs the one-time setup in docs/minipc-remote.md. Leave MINIPC_SSH_USER unset to turn it off.
# MINIPC_SSH_USER=your-user
# MINIPC_SSH_KEY=~/.ssh/nina_minipc
